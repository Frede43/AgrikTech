# ── Environnement ────────────────────────────────────────────────────────────
# "development" (défaut) ou "production". Toute valeur autre que
# development/dev/test/testing/local active les exigences de production.
# Hors développement/test : SECRET_KEY, SMS réel, mobile money API et sessions HTTPS sont requis.
ENVIRONMENT=development

# Obligatoire en production, 32 caractères minimum (générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Secret pour POST /bootstrap/admin (créer le premier admin sans accès shell,
# utile sur un plan gratuit). Laisser vide désactive l'endpoint (404).
# Se désactive de toute façon automatiquement dès qu'un admin existe déjà.
ADMIN_BOOTSTRAP_SECRET=

# ── Base de données ──────────────────────────────────────────────────────────
# SQLite par défaut (dev). En production, utiliser PostgreSQL :
# DATABASE_URL=postgresql://user:password@host:5432/agriconnect
DATABASE_URL=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Cookies de session servis uniquement en HTTPS (mettre true en production)
SESSION_HTTPS_ONLY=false
# "lax" en dev (front/back sur localhost = même site). Si le front et le
# back sont sur des domaines différents en production (ex. Vercel + Render),
# mettre "none" — nécessite SESSION_HTTPS_ONLY=true, sinon ignoré.
SESSION_SAMESITE=lax

# ── SMS (OTP de connexion) ───────────────────────────────────────────────────
# "console" en local | "twilio" | "africastalking" | "infobip" (obligatoire hors dev/test)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=

# Réglages OTP (optionnels)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Mobile money (Lumicash / Ecocash via agrégateur) ─────────────────────────
# "mock" en local | "api" (obligatoire hors dev/test, URL HTTPS + clé + secret webhook)
MOBILE_MONEY_PROVIDER=mock
MOBILE_MONEY_API_URL=
MOBILE_MONEY_API_KEY=
# Secret aléatoire de 32 caractères minimum partagé avec l'agrégateur.
MOBILE_MONEY_WEBHOOK_SECRET=

# Secret aléatoire de 32 caractères minimum partagé avec la passerelle USSD.
# Sans lui, le webhook répond 503.
USSD_WEBHOOK_SECRET=

# Stockage distant ; requis hors dev/test pour les images produit et les KYC privés.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Services externes ────────────────────────────────────────────────────────
# Distances routières réelles (facultatif) : https://openrouteservice.org
ORS_API_KEY=
