# ── Environnement ────────────────────────────────────────────────────────────
# "development" (défaut) ou "production".
# En production : SECRET_KEY est obligatoire et le mock_otp n'est jamais exposé.
ENVIRONMENT=development

# Obligatoire en production (générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Secret pour POST /bootstrap/admin (créer le premier admin sans accès shell,
# utile sur un plan gratuit). Laisser vide désactive l'endpoint (404).
# Se désactive de toute façon automatiquement dès qu'un admin existe déjà.
ADMIN_BOOTSTRAP_SECRET=

# ── Base de données ──────────────────────────────────────────────────────────
# SQLite par défaut (dev). En production, utiliser PostgreSQL :
# DATABASE_URL=postgresql://user:password@host:5432/agriconnect
DATABASE_URL=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Cookies de session servis uniquement en HTTPS (mettre true en production)
SESSION_HTTPS_ONLY=false
# "lax" en dev (front/back sur localhost = même site). Si le front et le
# back sont sur des domaines différents en production (ex. Vercel + Render),
# mettre "none" — nécessite SESSION_HTTPS_ONLY=true, sinon ignoré.
SESSION_SAMESITE=lax

# ── SMS (OTP de connexion) ───────────────────────────────────────────────────
# "console" (simulateur, défaut) | "twilio" | "africastalking"
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Réglages OTP (optionnels)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Mobile money (Lumicash / Ecocash via agrégateur) ─────────────────────────
# "mock" (paiement simulé instantané, défaut) | "api" (agrégateur REST + webhook)
MOBILE_MONEY_PROVIDER=mock
MOBILE_MONEY_API_URL=
MOBILE_MONEY_API_KEY=
# Secret partagé validé sur POST /payments/webhook (obligatoire si provider=api)
MOBILE_MONEY_WEBHOOK_SECRET=

# ── Services externes ────────────────────────────────────────────────────────
# Distances routières réelles (facultatif) : https://openrouteservice.org
ORS_API_KEY=
